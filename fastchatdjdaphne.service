[Unit]
Description=Daphne ASGI Server
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/home/fastchat/fastchatdj
ExecStart=/home/fastchat/fastchatdj/venv/bin/daphne -u /run/sockets/daphne.sock --application-close-timeout 180 fastchatdj.asgi:application
Restart=on-failure
KillSignal=SIGTERM
TimeoutStopSec=200
Type=simple
NotifyAccess=all

[Install]
WantedBy=multi-user.target
